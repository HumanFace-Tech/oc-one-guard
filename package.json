{
  "name": "oc-one-guard",
  "version": "0.1.0",
  "description": "OpenCode v1-only plugin that checks proposed tool calls for outbound data exfiltration with a local decision-model judge",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./server": "./index.js"
  },
  "files": [
    "index.js",
    "src/",
    "config.example.json",
    "README.md",
    "docs/assets/risk-policy.svg"
  ],
  "scripts": {
    "test": "node --test test/config.test.js test/guard.test.js test/judge.test.js test/plugin.test.js test/security.test.js test/stop.test.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumanFace-Tech/oc-one-guard.git"
  },
  "bugs": {
